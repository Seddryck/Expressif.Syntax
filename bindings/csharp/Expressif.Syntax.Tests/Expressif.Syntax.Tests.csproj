<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackageVersionUnderTest)' == ''">
    <ProjectReference Include="..\Expressif.Syntax\Expressif.Syntax.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackageVersionUnderTest)' != ''">
    <PackageReference Include="Expressif.Syntax" Version="$(PackageVersionUnderTest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\src\node-types.json" Link="node-types.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyExpressifGrammar" AfterTargets="Build" Condition="'$(TargetFramework)' != '' And '$(PackageVersionUnderTest)' == ''">
    <PropertyGroup>
      <ExpressifGrammarLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">tree-sitter-expressif.dll</ExpressifGrammarLibrary>
      <ExpressifGrammarLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">libtree-sitter-expressif.so</ExpressifGrammarLibrary>
      <ExpressifGrammarLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">libtree-sitter-expressif.dylib</ExpressifGrammarLibrary>
    </PropertyGroup>
    <Copy SourceFiles="..\Expressif.Syntax\bin\$(Configuration)\$(TargetFramework)\$(ExpressifGrammarLibrary)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
