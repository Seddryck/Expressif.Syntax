<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Expressif.Syntax</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ExpressifGrammarLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">tree-sitter-expressif.dll</ExpressifGrammarLibrary>
    <ExpressifGrammarLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">libtree-sitter-expressif.so</ExpressifGrammarLibrary>
    <ExpressifGrammarLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">libtree-sitter-expressif.dylib</ExpressifGrammarLibrary>
    <TreeSitterCli>tree-sitter</TreeSitterCli>
    <TreeSitterCli Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(MSBuildThisFileDirectory)..\..\..\node_modules\.bin\tree-sitter.cmd')">$(MSBuildThisFileDirectory)..\..\..\node_modules\.bin\tree-sitter.cmd</TreeSitterCli>
    <TreeSitterCli Condition="!$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(MSBuildThisFileDirectory)../../../node_modules/.bin/tree-sitter')">$(MSBuildThisFileDirectory)../../../node_modules/.bin/tree-sitter</TreeSitterCli>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativeAssetsDirectory)' != ''">
    <None Include="$(NativeAssetsDirectory)/win-x64/tree-sitter-expressif.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          Visible="false" />
    <None Include="$(NativeAssetsDirectory)/win-arm64/tree-sitter-expressif.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/"
          Visible="false" />
    <None Include="$(NativeAssetsDirectory)/linux-x64/libtree-sitter-expressif.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/"
          Visible="false" />
    <None Include="$(NativeAssetsDirectory)/linux-arm64/libtree-sitter-expressif.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/"
          Visible="false" />
    <None Include="$(NativeAssetsDirectory)/osx-x64/libtree-sitter-expressif.dylib"
          Pack="true"
          PackagePath="runtimes/osx-x64/native/"
          Visible="false" />
    <None Include="$(NativeAssetsDirectory)/osx-arm64/libtree-sitter-expressif.dylib"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidateNativePackageAssets" BeforeTargets="Pack" Condition="'$(NativeAssetsDirectory)' != ''">
    <Error Condition="!Exists('$(NativeAssetsDirectory)/win-x64/tree-sitter-expressif.dll')"
           Text="The Windows native grammar library was not found in '$(NativeAssetsDirectory)/win-x64'." />
    <Error Condition="!Exists('$(NativeAssetsDirectory)/win-arm64/tree-sitter-expressif.dll')"
           Text="The Windows ARM64 native grammar library was not found in '$(NativeAssetsDirectory)/win-arm64'." />
    <Error Condition="!Exists('$(NativeAssetsDirectory)/linux-x64/libtree-sitter-expressif.so')"
           Text="The Linux native grammar library was not found in '$(NativeAssetsDirectory)/linux-x64'." />
    <Error Condition="!Exists('$(NativeAssetsDirectory)/linux-arm64/libtree-sitter-expressif.so')"
           Text="The Linux ARM64 native grammar library was not found in '$(NativeAssetsDirectory)/linux-arm64'." />
    <Error Condition="!Exists('$(NativeAssetsDirectory)/osx-x64/libtree-sitter-expressif.dylib')"
           Text="The macOS x64 native grammar library was not found in '$(NativeAssetsDirectory)/osx-x64'." />
    <Error Condition="!Exists('$(NativeAssetsDirectory)/osx-arm64/libtree-sitter-expressif.dylib')"
           Text="The macOS ARM64 native grammar library was not found in '$(NativeAssetsDirectory)/osx-arm64'." />
  </Target>

  <Target Name="BuildExpressifGrammar" BeforeTargets="Build" Condition="'$(NativeAssetsDirectory)' == ''" Inputs="$(MSBuildThisFileDirectory)..\..\..\src\parser.c" Outputs="$(TargetDir)$(ExpressifGrammarLibrary)">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\..\.." Command="&quot;$(TreeSitterCli)&quot; build -o &quot;$(TargetDir)$(ExpressifGrammarLibrary)&quot; ." />
  </Target>
</Project>
